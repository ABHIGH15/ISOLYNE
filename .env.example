# Isolyne Environment Variables

# Google Gemini API Key for Natural Language Decision Parsing
EXPO_PUBLIC_GEMINI_API_KEY=
# Default: gemini-3.7-flash (stable production GA model for structured JSON parsing)
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.7-flash

# RevenueCat API Keys (Optional for local preview / Expo Go simulation)
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
